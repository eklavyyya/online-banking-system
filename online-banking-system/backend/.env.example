# Server
PORT=4000
NODE_ENV=development

# Database
# DB_DIALECT = sqlite (default, zero-setup local dev) | mysql (production target per SRS)
DB_DIALECT=sqlite
DB_STORAGE=./data/obs.sqlite

# Only used when DB_DIALECT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=online_banking_system
DB_USER=root
DB_PASSWORD=

# Auth
JWT_SECRET=replace_this_with_a_long_random_string_in_production
JWT_EXPIRES_IN=1h
OTP_EXPIRY_SECONDS=300
BENEFICIARY_COOLING_PERIOD_MINUTES=30
MPIN_MAX_ATTEMPTS=3
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Simulated Core Banking System: probability (0-1) that a posting is declined.
# 0 = never fail (best for demos); 0.05 shows the failure path about 1 time in 20.
CBS_SIMULATED_FAILURE_RATE=0

# Transfer rules
RTGS_MIN_AMOUNT=200000
IMPS_MAX_AMOUNT=500000
NEFT_MAX_AMOUNT=2500000
